#    Individuals (Example Instances)
#################################################################

###  http://example.org/trust-domain#ExampleForeignTrust
:ExampleForeignTrust rdf:type owl:NamedIndividual ,
                              :ForeignPrivateIrrevocableNonGrantorTrust ;
    :isRevocable "false"^^xsd:boolean ;
    :isGrantorTrust "false"^^xsd:boolean ;
    :isForeign "true"^^xsd:boolean ;
    :isDomestic "false"^^xsd:boolean ;
    :jurisdiction "Nevis" ;
    :hasCourtJurisdiction "Nevis High Court" ;
    :hasControlLocation "Nevis" ;
    :establishedDate "2024-01-15"^^xsd:date ;
    :hasEIN "98-1234567" ;
    :hasSystemIdentifier :ExampleForeignTrust_EIN ;
    :hasTrustee :ExampleTrustee ;
    rdfs:label "Example Foreign Private Irrevocable Non-Grantor Trust"@en ;
    rdfs:comment "Demonstrates foreign trust that has crossed IRC §§671-679 gateway, operates under IRC §§641-685 as autonomous system, classified under IRC §7701"@en .


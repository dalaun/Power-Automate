#################################################################
#    Restrictions and Axioms
#################################################################

###  Foreign Private Irrevocable Non-Grantor Trust must have Trustee
:ForeignPrivateIrrevocableNonGrantorTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasTrustee ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Every Instrument must be governed by at least one DoctrinalSource
:Instrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Every Instrument must be substantiated by Evidence
:Instrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :substantiatedBy ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Accountable Plan requires substantiation and return of excess
:AccountablePlan rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requiresEvidence ;
      owl:someValuesFrom :BusinessRecords
    ] .

###  Reimbursement Instrument must follow Accountable Plan
:ReimbursementInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requiresEvidence ;
      owl:someValuesFrom :AccountablePlan
    ] .

###  Operational Activity must advance a Purpose
:OperationalActivity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :advancesPurpose ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Operational Activity within boundary must be Ordinary and Necessary
[ rdf:type owl:Restriction ;
  owl:onProperty :withinBoundary ;
  owl:someValuesFrom :OperatingBoundary
] rdfs:subClassOf :OrdinaryAndNecessaryExpense .

###  Safeguard Mechanisms prevent Authority Collapse
:SafeguardMechanism rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :preventsMisuse ;
      owl:someValuesFrom :AuthorityCollapse
    ] .

###  Trust Entity must exercise Authority
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :exercisesAuthority ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Depreciation Instrument applies to Depreciable Assets
:DepreciationInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :substantiatedBy ;
      owl:someValuesFrom :AssetRecords
    ] .

###  Fringe Benefit governed by Pub 15-B
:FringeBenefit rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :Pub_15B
    ] .

###  Wage Instrument governed by Pub 15
:WageInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :Pub_15
    ] .

###  Non-Cash Operational Instrument governed by IRC §132
:NonCashOperationalInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_132
    ] .

###  Mobility Instrument governed by Pub 463
:MobilityInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :Pub_463
    ] .

###  Ordinary and Necessary Expense governed by IRC §162
:OrdinaryAndNecessaryExpense rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_162
    ] .

###  Capital Expenditure governed by IRC §263
:CapitalExpenditure rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_263
    ] .

###  Capability Investment governed by IRC §117 or §127
:CapabilityInvestmentInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:someValuesFrom [ rdf:type owl:Class ;
                           owl:unionOf ( :IRC_117 :IRC_127 )
                         ]
    ] .

###  Non-Grantor Trust System - THE GATEWAY under IRC §§671-679
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_671_679
    ] .

###  Non-Grantor Trust operates as autonomous accounting system under IRC §§641-685
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_641_685
    ] .

###  Non-Grantor Trust must have system identifier (EIN)
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasSystemIdentifier ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Non-Grantor Trust must file fiduciary return
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requiresFiling ;
      owl:someValuesFrom :FiduciaryReturn
    ] .

###  Non-Grantor Trust can compute DNI
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :computesDNI ;
      owl:someValuesFrom :DistributableNetIncome
    ] .

###  Foreign Trust determined by IRC §7701 jurisdictional tests
[ rdf:type owl:Restriction ;
  owl:onProperty :isForeign ;
  owl:hasValue "true"^^xsd:boolean
] rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_7701
    ] .

###  Domestic Trust must pass both court and control tests
:DomesticTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :passesJurisdictionalTest ;
      owl:minCardinality "2"^^xsd:nonNegativeInteger
    ] .

###  Income Production Expense governed by IRC §212
:IncomeProductionExpense rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_212
    ] .

###  Fiduciary-Specific Expense governed by IRC §67(e)
:FiduciarySpecificExpense rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_67e
    ] .

###  Distribution must flow character through to beneficiary
:Distribution rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :flowsCharacterThrough ;
      owl:someValuesFrom :CharacterFlowThrough
    ] .

###  EIN is NOT an Instrument - disjoint classes
:EIN owl:disjointWith :Instrument .

###  System Identifier is NOT an Instrument - disjoint classes
:SystemIdentifier owl:disjointWith :Instrument .

###  Private Irrevocable Non-Grantor Trust is a Non-Grantor Trust System
:PrivateIrrevocableNonGrantorTrust rdfs:subClassOf :NonGrantorTrustSystem .

###  Foreign Private Irrevocable Non-Grantor Trust governed by IRC §7701
:ForeignPrivateIrrevocableNonGrantorTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_7701
    ] .


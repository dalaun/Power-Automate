@prefix : <http://example.org/trust-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/trust-domain#> .

<http://example.org/trust-domain> rdf:type owl:Ontology ;
    rdfs:label "Trust Domain Ontology"@en ;
    rdfs:comment """Canonical ontology for private & foreign irrevocable non-grantor trust domains, modeling authority, instruments, and operational boundaries.

This ontology treats tax code sections not as 'tax rules' but as recognized instruments, authority boundaries, evidence schemas, and control-plane components.

CRITICAL ARCHITECTURE:
- IRC §§671-679: The GATEWAY - creates separation between grantor and trust (control-of-income boundary)
- IRC §§641-685: The OPERATING SYSTEM - enables trust as autonomous accounting system (DNI, distributions, character flow-through)
- IRC §7701: The JURISDICTION - assigns which sovereign's rules apply (court + control tests)
- IRC §162/§212/§67(e): The EXPENSE INSTRUMENTS - operational spending power for trusts
- EIN: System identifier (MAC address, not protocol) - NOT an instrument

Non-grantor and foreign trusts acquire operational instruments once control, jurisdiction, and fiduciary authority are cleanly separated under the doctrinal stack."""@en ;
    owl:versionInfo "2.0" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/trust-domain#exercisesAuthority
:exercisesAuthority rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range :Authority ;
    rdfs:label "exercises authority"@en ;
    rdfs:comment "Relates a trust entity to the authority it exercises"@en .

###  http://example.org/trust-domain#advancesPurpose
:advancesPurpose rdf:type owl:ObjectProperty ;
    rdfs:domain :OperationalActivity ;
    rdfs:range :Purpose ;
    rdfs:label "advances purpose"@en ;
    rdfs:comment "Links an operational activity to the purpose it advances"@en .

###  http://example.org/trust-domain#implementedBy
:implementedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Purpose ;
    rdfs:range :Instrument ;
    rdfs:label "implemented by"@en ;
    rdfs:comment "Relates a purpose to the instruments that implement it"@en .

###  http://example.org/trust-domain#substantiatedBy
:substantiatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Instrument ;
    rdfs:range :Evidence ;
    rdfs:label "substantiated by"@en ;
    rdfs:comment "Links an instrument to the evidence that substantiates it"@en .

###  http://example.org/trust-domain#governedBy
:governedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Instrument ;
    rdfs:range :DoctrinalSource ;
    rdfs:label "governed by"@en ;
    rdfs:comment "Indicates which doctrinal source governs an instrument"@en .

###  http://example.org/trust-domain#hasBeneficiary
:hasBeneficiary rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustStructure ;
    rdfs:range :Beneficiary ;
    rdfs:label "has beneficiary"@en .

###  http://example.org/trust-domain#hasTrustee
:hasTrustee rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustStructure ;
    rdfs:range :Trustee ;
    rdfs:label "has trustee"@en .

###  http://example.org/trust-domain#hasProtector
:hasProtector rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustStructure ;
    rdfs:range :Protector ;
    rdfs:label "has protector"@en .

###  http://example.org/trust-domain#employs
:employs rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range :HumanCapability ;
    rdfs:label "employs"@en ;
    rdfs:comment "Relates trust entity to human capabilities it employs"@en .

###  http://example.org/trust-domain#controls
:controls rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range :Asset ;
    rdfs:label "controls"@en ;
    rdfs:comment "Indicates asset control relationship"@en .

###  http://example.org/trust-domain#incurs
:incurs rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range :Expenditure ;
    rdfs:label "incurs"@en ;
    rdfs:comment "Relates entity to expenditures it incurs"@en .

###  http://example.org/trust-domain#withinBoundary
:withinBoundary rdf:type owl:ObjectProperty ;
    rdfs:domain :OperationalActivity ;
    rdfs:range :OperatingBoundary ;
    rdfs:label "within boundary"@en ;
    rdfs:comment "Indicates activity is within operational boundary"@en .

###  http://example.org/trust-domain#requiresEvidence
:requiresEvidence rdf:type owl:ObjectProperty ;
    rdfs:domain :Instrument ;
    rdfs:range :EvidenceDiscipline ;
    rdfs:label "requires evidence"@en .

###  http://example.org/trust-domain#preventsMisuse
:preventsMisuse rdf:type owl:ObjectProperty ;
    rdfs:domain :SafeguardMechanism ;
    rdfs:range :AuthorityCollapse ;
    rdfs:label "prevents misuse"@en .

###  http://example.org/trust-domain#retainsControlPower
:retainsControlPower rdf:type owl:ObjectProperty ;
    rdfs:domain :Grantor ;
    rdfs:range :ControlPower ;
    rdfs:label "retains control power"@en ;
    rdfs:comment "Grantor retains enumerated control power under IRC §§671-679"@en .

###  http://example.org/trust-domain#lacksRetainedControl
:lacksRetainedControl rdf:type owl:ObjectProperty ;
    rdfs:domain :NonGrantorTrustSystem ;
    rdfs:range :ControlPower ;
    rdfs:label "lacks retained control"@en ;
    rdfs:comment "Trust lacks enumerated control powers, crossing the non-grantor boundary"@en .

###  http://example.org/trust-domain#makesDistribution
:makesDistribution rdf:type owl:ObjectProperty ;
    rdfs:domain :NonGrantorTrustSystem ;
    rdfs:range :Distribution ;
    rdfs:label "makes distribution"@en ;
    rdfs:comment "Trust distributes income or corpus to beneficiaries"@en .

###  http://example.org/trust-domain#passesJurisdictionalTest
:passesJurisdictionalTest rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustStructure ;
    rdfs:range :JurisdictionalTest ;
    rdfs:label "passes jurisdictional test"@en ;
    rdfs:comment "Trust satisfies court or control test for jurisdictional classification"@en .

###  http://example.org/trust-domain#hasSystemIdentifier
:hasSystemIdentifier rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range :SystemIdentifier ;
    rdfs:label "has system identifier"@en ;
    rdfs:comment "Trust has system identifier (EIN) - not an instrument, but required for interaction"@en .

###  http://example.org/trust-domain#computesDNI
:computesDNI rdf:type owl:ObjectProperty ;
    rdfs:domain :NonGrantorTrustSystem ;
    rdfs:range :DistributableNetIncome ;
    rdfs:label "computes DNI"@en ;
    rdfs:comment "Trust computes Distributable Net Income per IRC §§641-685"@en .

###  http://example.org/trust-domain#flowsCharacterThrough
:flowsCharacterThrough rdf:type owl:ObjectProperty ;
    rdfs:domain :Distribution ;
    rdfs:range :CharacterFlowThrough ;
    rdfs:label "flows character through"@en ;
    rdfs:comment "Distribution carries income character to beneficiary"@en .

###  http://example.org/trust-domain#requiresFiling
:requiresFiling rdf:type owl:ObjectProperty ;
    rdfs:domain :NonGrantorTrustSystem ;
    rdfs:range :FiduciaryReturn ;
    rdfs:label "requires filing"@en ;
    rdfs:comment "Trust must file fiduciary tax return (Form 1041)"@en .


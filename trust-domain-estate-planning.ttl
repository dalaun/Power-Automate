#################################################################
#    Class Restrictions (Cardinality Constraints)
#################################################################

###  TRUST MUST have at least one Grantor
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:hasGrantor ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

###  TRUST MUST have at least one Beneficiary
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasBeneficiary ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

###  TRUST can have at most one Protector
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasProtector ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

###  TRUST established by exactly ONE document
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:establishedBy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

###  TRUST governed by exactly ONE document
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:governedBy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

###  TRUST holds exactly ONE corpus
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:holdsCorpus ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

###  TRUSTEE owes at least one Fiduciary Duty
ep:Trustee rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:owes ;
      owl:someValuesFrom ep:FiduciaryDuty ] .

###  DOCUMENT executed by at least one Participant
ep:Document rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:executedBy ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

###  LEGAL ACTION initiated by exactly one Participant
ep:LegalAction rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:initiatedBy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

###  LEGAL ACTION judged by exactly one Judge
ep:LegalAction rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty ep:judgedBy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .


#################################################################
#    Property Chains (Critical Cross-Class Patterns)
#################################################################

###  TRUST → Trustee → Fiduciary Duty (Fiduciary Duty Pattern)
ep:requiresFiduciaryDuty rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( :hasTrustee ep:owes ) ;
    rdfs:label "requires fiduciary duty"@en ;
    rdfs:comment "Trust requires fiduciary duty through trustee relationship"@en .

###  TRUST → Corpus → Asset (Asset Holding Pattern)
ep:ultimatelyHolds rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( ep:holdsCorpus ep:formOfHolding ) ;
    rdfs:label "ultimately holds"@en ;
    rdfs:comment "Trust ultimately holds assets through corpus"@en .

###  BENEFICIARY → Beneficial Interest → Corpus (Beneficial Interest Pattern)
ep:beneficialInterestInCorpus rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( ep:holdsInterest ep:createdBy ep:holdsCorpus ) ;
    rdfs:label "beneficial interest in corpus"@en ;
    rdfs:comment "Beneficiary holds beneficial interest in trust corpus"@en .


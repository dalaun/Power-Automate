@prefix : <http://example.org/trust-domain#> .
@prefix ep: <http://example.org/trust-domain/estate-planning#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/trust-domain/estate-planning#> .

<http://example.org/trust-domain/estate-planning> rdf:type owl:Ontology ;
    owl:imports <http://example.org/trust-domain> ;
    rdfs:label "Trust Domain Estate Planning Extension"@en ;
    rdfs:comment """Comprehensive estate planning vocabulary extending the Trust Domain Ontology
with traditional trust and estate concepts from Passbuckdefs glossary.

This extension adds:
- Participant role taxonomy (Grantor, Settlor, Beneficiary variants)
- Document/instrument hierarchy (Deeds, Trust Agreements, Amendments)
- Property tenure and ownership forms (Fee Simple, Life Estate, Remainder)
- Legal action/proceeding framework (Contests, Reformation, Accounting)
- Transaction framework (Arm's Length, Related Party, Fair Value)
- Common law trust doctrines (Rule Against Perpetuities, Cy Pres, Spendthrift Clauses)
- Arm's length dealing standards (Arm's Length Standard, Fair Dealing, Conflict of Interest)
- Hague Trusts Convention framework (Cross-border trust recognition)
- Comprehensive relationship properties with inverses
- Cardinality constraints ensuring ontological integrity
- Property chains for complex legal patterns

COMMON LAW TRUST DOCTRINES:
- Rule Against Perpetuities: Limits duration of future interests
- Cy Pres Doctrine: Modification of charitable trusts when purpose becomes impossible
- Merger Doctrine: Termination when legal and equitable title merge
- Spendthrift Clauses: Protection from creditors
- Discretionary Trust Standards: Trustee discretion over distributions
- Ascertainable Standards: HEMS (Health, Education, Maintenance, Support)

ARM'S LENGTH DEALING:
- Arm's Length Transaction: Transactions between unrelated parties (DISJOINT from Related Party)
- Related Party Transaction: Transactions requiring heightened scrutiny
- Fair Value Transaction: Transactions at fair market value
- Below Market Transaction: Transactions below FMV (potential prohibited transactions)
- Arm's Length Standard: Unrelated party dealing requirement
- Fair Dealing Standard: Fiduciary fair dealing requirement
- Conflict of Interest: Fiduciary personal interest conflicts
- Independent Trustee Requirement: Trustee without conflicts

HAGUE TRUSTS CONVENTION (v1.2):
The Convention provides a recognition layer for cross-border trusts without harmonizing
substantive trust law. Key principles:

TWO-STEP VALIDITY MODEL (most consequential clarification):
  Step One: Trust Validity - Is there a valid trust instrument?
  Step Two: Asset Transfer Validity - Was property validly transferred into trust?

  CRITICAL: These steps are analytically separate. A trust can exist even if a
  particular transfer fails, and a failed conveyance does not retroactively destroy
  the trust agreement itself.

RECOGNITION VS REINVENTION:
  Foreign trusts are recognized without requiring domestic law to adopt foreign
  trust doctrines. Recognition does not mean reinvention of local property law.

SITUS RULE PRESERVATION:
  Law of property location (lex situs) controls title, conveyance, creditor rights,
  and recording requirements. The Hague Convention does NOT displace situs rules.

CHOICE OF LAW WITH FENCES:
  Settlor's choice of governing law is honored subject to:
  - Meaningful connection requirement
  - Mandatory rules (creditor rights, forced heirship, public policy)
  - Public policy exceptions

MANDATORY RULES:
  Overriding rules that cannot be displaced by choice of law:
  - Creditor rights
  - Forced heirship (legitime portions)
  - Fundamental public policy

Classes: HagueTrustsConvention, TrustRecognition, TrustValidity, AssetTransferValidity,
         ChoiceOfLaw, MandatoryRule, PublicPolicyException, SitusRule, CrossBorderTrust,
         ForcedHeirship

Properties: recognizedUnder, satisfiesTrustValidity, satisfiesTransferValidity,
            choosesGoverningLaw, subjectToMandatoryRule, governedBySitusRule,
            operatesInJurisdiction, subjectToForcedHeirship

Designed for traditional estate planning while maintaining compatibility with
the foundation-focused private trust framework in the base ontology."""@en ;
    owl:versionInfo "1.2" .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/trust-domain/estate-planning#glossaryTerm
ep:glossaryTerm rdf:type owl:AnnotationProperty ;
    rdfs:label "glossary term"@en ;
    rdfs:comment "Maps to specific term from Passbuckdefs glossary"@en .


#################################################################
#    Object Properties
#################################################################

###############################################################
###  SECTION 1: TRUST-CENTERED RELATIONSHIPS
###############################################################

###  Participant Role Properties

###  http://example.org/trust-domain/estate-planning#hasGrantor
ep:hasGrantor rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Grantor ;
    owl:inverseOf ep:creates ;
    rdfs:label "has grantor"@en ;
    rdfs:comment "Trust has grantor who created and funded it"@en ;
    ep:glossaryTerm "Grantor, Creator, Trustor" .

###  http://example.org/trust-domain/estate-planning#creates
ep:creates rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain ep:Grantor ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasGrantor ;
    rdfs:label "creates"@en ;
    rdfs:comment "Grantor creates trust"@en .

###  http://example.org/trust-domain/estate-planning#hasSettlor
ep:hasSettlor rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Settlor ;
    owl:inverseOf ep:settles ;
    rdfs:label "has settlor"@en ;
    rdfs:comment "Trust has settlor who settled property into it"@en ;
    ep:glossaryTerm "Settlor" .

###  http://example.org/trust-domain/estate-planning#settles
ep:settles rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Settlor ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasSettlor ;
    rdfs:label "settles"@en ;
    rdfs:comment "Settlor settles property into trust"@en .

###  http://example.org/trust-domain/estate-planning#hasCoTrustee
ep:hasCoTrustee rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:CoTrustee ;
    owl:inverseOf ep:servesAs ;
    rdfs:label "has co-trustee"@en ;
    rdfs:comment "Trust has co-trustee serving jointly with other trustees"@en ;
    ep:glossaryTerm "CoTrustee" .

###  http://example.org/trust-domain/estate-planning#servesAs
ep:servesAs rdf:type owl:ObjectProperty ;
    rdfs:domain ep:CoTrustee ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasCoTrustee ;
    rdfs:label "serves as"@en ;
    rdfs:comment "Co-trustee serves trust"@en .

###  http://example.org/trust-domain/estate-planning#hasSuccessorTrustee
ep:hasSuccessorTrustee rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:SuccessorTrustee ;
    owl:inverseOf ep:willServe ;
    rdfs:label "has successor trustee"@en ;
    rdfs:comment "Trust has successor trustee designated to serve upon predecessor's removal"@en ;
    ep:glossaryTerm "SuccessorTrustee" .

###  http://example.org/trust-domain/estate-planning#willServe
ep:willServe rdf:type owl:ObjectProperty ;
    rdfs:domain ep:SuccessorTrustee ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasSuccessorTrustee ;
    rdfs:label "will serve"@en ;
    rdfs:comment "Successor trustee will serve trust upon triggering event"@en .

###  http://example.org/trust-domain/estate-planning#hasIncomeBeneficiary
ep:hasIncomeBeneficiary rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:IncomeBeneficiary ;
    owl:inverseOf ep:receivesIncomeFrom ;
    rdfs:label "has income beneficiary"@en ;
    rdfs:comment "Trust has income beneficiary entitled to income distributions"@en ;
    ep:glossaryTerm "IncomeBeneficiary" .

###  http://example.org/trust-domain/estate-planning#receivesIncomeFrom
ep:receivesIncomeFrom rdf:type owl:ObjectProperty ;
    rdfs:domain ep:IncomeBeneficiary ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasIncomeBeneficiary ;
    rdfs:label "receives income from"@en ;
    rdfs:comment "Income beneficiary receives income from trust"@en .

###  http://example.org/trust-domain/estate-planning#hasRemainderBeneficiary
ep:hasRemainderBeneficiary rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ep:participatesIn ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:RemainderBeneficiary ;
    owl:inverseOf ep:receivesCorpusFrom ;
    rdfs:label "has remainder beneficiary"@en ;
    rdfs:comment "Trust has remainder beneficiary (remainderman) entitled to corpus upon termination"@en ;
    ep:glossaryTerm "Remainderman, RemainderBeneficiary" .

###  http://example.org/trust-domain/estate-planning#receivesCorpusFrom
ep:receivesCorpusFrom rdf:type owl:ObjectProperty ;
    rdfs:domain ep:RemainderBeneficiary ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasRemainderBeneficiary ;
    rdfs:label "receives corpus from"@en ;
    rdfs:comment "Remainder beneficiary receives corpus from trust upon termination"@en .

###  Super-property for all participant relationships
###  http://example.org/trust-domain/estate-planning#participatesIn
ep:participatesIn rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Participant ;
    rdfs:range :TrustEntity ;
    rdfs:label "participates in"@en ;
    rdfs:comment "Participant has some role in trust"@en .

###  Document Governance Properties

###  http://example.org/trust-domain/estate-planning#governedBy
ep:governedBy rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Document ;
    owl:inverseOf ep:governs ;
    rdfs:label "governed by"@en ;
    rdfs:comment "Trust governed by trust indenture or agreement (functional - only one governing document)"@en ;
    ep:glossaryTerm "TrustIndenture, TrustAgreement" .

###  http://example.org/trust-domain/estate-planning#governs
ep:governs rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Document ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:governedBy ;
    rdfs:label "governs"@en ;
    rdfs:comment "Document governs trust operations"@en .

###  http://example.org/trust-domain/estate-planning#establishedBy
ep:establishedBy rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Document ;
    owl:inverseOf ep:establishes ;
    rdfs:label "established by"@en ;
    rdfs:comment "Trust established by specific document (functional - only one establishment document)"@en ;
    ep:glossaryTerm "TrustIndenture, DeclarationOfTrust" .

###  http://example.org/trust-domain/estate-planning#establishes
ep:establishes rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Document ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:establishedBy ;
    rdfs:label "establishes"@en ;
    rdfs:comment "Document establishes trust"@en .

###  http://example.org/trust-domain/estate-planning#amendedBy
ep:amendedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:TrustAmendment ;
    owl:inverseOf ep:amends ;
    rdfs:label "amended by"@en ;
    rdfs:comment "Trust amended by amendment document"@en ;
    ep:glossaryTerm "TrustAmendment" .

###  http://example.org/trust-domain/estate-planning#amends
ep:amends rdf:type owl:ObjectProperty ;
    rdfs:domain ep:TrustAmendment ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:amendedBy ;
    rdfs:label "amends"@en ;
    rdfs:comment "Amendment modifies trust"@en .

###  http://example.org/trust-domain/estate-planning#restatedBy
ep:restatedBy rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Restatement ;
    owl:inverseOf ep:restates ;
    rdfs:label "restated by"@en ;
    rdfs:comment "Trust restated by restatement document"@en ;
    ep:glossaryTerm "Restatement" .

###  http://example.org/trust-domain/estate-planning#restates
ep:restates rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Restatement ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:restatedBy ;
    rdfs:label "restates"@en ;
    rdfs:comment "Restatement restates entire trust"@en .

###  http://example.org/trust-domain/estate-planning#terminatedBy
ep:terminatedBy rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:TerminationAgreement ;
    owl:inverseOf ep:terminates ;
    rdfs:label "terminated by"@en ;
    rdfs:comment "Trust terminated by termination agreement or certificate"@en ;
    ep:glossaryTerm "TerminationAgreement, CertificateOfTermination" .

###  http://example.org/trust-domain/estate-planning#terminates
ep:terminates rdf:type owl:ObjectProperty ;
    rdfs:domain ep:TerminationAgreement ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:terminatedBy ;
    rdfs:label "terminates"@en ;
    rdfs:comment "Document terminates trust"@en .

###  Asset Holding Properties

###  http://example.org/trust-domain/estate-planning#holdsCorpus
ep:holdsCorpus rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Corpus ;
    owl:inverseOf ep:isCorpusOf ;
    rdfs:label "holds corpus"@en ;
    rdfs:comment "Trust holds corpus (principal, res) - functional property"@en ;
    ep:glossaryTerm "Corpus, Res, TrustEstate, Principal" .

###  http://example.org/trust-domain/estate-planning#isCorpusOf
ep:isCorpusOf rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Corpus ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:holdsCorpus ;
    rdfs:label "is corpus of"@en ;
    rdfs:comment "Corpus belongs to trust"@en .

###  http://example.org/trust-domain/estate-planning#receivesProperty
ep:receivesProperty rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:transferredTo ;
    rdfs:label "receives property"@en ;
    rdfs:comment "Trust receives property via transfer or contribution"@en ;
    ep:glossaryTerm "Contribution, Transfer" .

###  http://example.org/trust-domain/estate-planning#transferredTo
ep:transferredTo rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:receivesProperty ;
    rdfs:label "transferred to"@en ;
    rdfs:comment "Asset transferred to trust"@en .

###  http://example.org/trust-domain/estate-planning#distributesAsset
ep:distributesAsset rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:distributedFrom ;
    rdfs:label "distributes asset"@en ;
    rdfs:comment "Trust distributes asset to beneficiary"@en ;
    ep:glossaryTerm "Distribution" .

###  http://example.org/trust-domain/estate-planning#distributedFrom
ep:distributedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:distributesAsset ;
    rdfs:label "distributed from"@en ;
    rdfs:comment "Asset distributed from trust"@en .

###  Jurisdictional Properties

###  http://example.org/trust-domain/estate-planning#operatesUnder
ep:operatesUnder rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Jurisdiction ;
    owl:inverseOf ep:jurisdictionOver ;
    rdfs:label "operates under"@en ;
    rdfs:comment "Trust operates under specific jurisdiction"@en ;
    ep:glossaryTerm "Jurisdiction, Situs, Domicile" .

###  http://example.org/trust-domain/estate-planning#jurisdictionOver
ep:jurisdictionOver rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Jurisdiction ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:operatesUnder ;
    rdfs:label "jurisdiction over"@en ;
    rdfs:comment "Jurisdiction governs trust"@en .

###  http://example.org/trust-domain/estate-planning#hasSitus
ep:hasSitus rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:Situs ;
    owl:inverseOf ep:locationOf ;
    rdfs:label "has situs"@en ;
    rdfs:comment "Trust has situs (legal location)"@en ;
    ep:glossaryTerm "Situs" .

###  http://example.org/trust-domain/estate-planning#locationOf
ep:locationOf rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Situs ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:hasSitus ;
    rdfs:label "location of"@en ;
    rdfs:comment "Situs is location of trust"@en .

###  Legal Interest Properties

###  http://example.org/trust-domain/estate-planning#createsInterest
ep:createsInterest rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:BeneficialInterest ;
    owl:inverseOf ep:createdBy ;
    rdfs:label "creates interest"@en ;
    rdfs:comment "Trust creates beneficial or equitable interest"@en ;
    ep:glossaryTerm "BeneficialInterest, EquitableInterest, VestedInterest, ContingentInterest" .

###  http://example.org/trust-domain/estate-planning#createdBy
ep:createdBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:BeneficialInterest ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:createsInterest ;
    rdfs:label "created by"@en ;
    rdfs:comment "Interest created by trust"@en .

###  Legal Action Properties

###  http://example.org/trust-domain/estate-planning#subjectOfProceeding
ep:subjectOfProceeding rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:LegalAction ;
    owl:inverseOf ep:involves ;
    rdfs:label "subject of proceeding"@en ;
    rdfs:comment "Trust is subject of legal proceeding"@en ;
    ep:glossaryTerm "TrustContest, AccountingProceeding, Reformation" .

###  http://example.org/trust-domain/estate-planning#involves
ep:involves rdf:type owl:ObjectProperty ;
    rdfs:domain ep:LegalAction ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:subjectOfProceeding ;
    rdfs:label "involves"@en ;
    rdfs:comment "Legal action involves trust"@en .

###  http://example.org/trust-domain/estate-planning#contestedBy
ep:contestedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:TrustContest ;
    owl:inverseOf ep:contests ;
    rdfs:label "contested by"@en ;
    rdfs:comment "Trust contested by legal action"@en ;
    ep:glossaryTerm "TrustContest" .

###  http://example.org/trust-domain/estate-planning#contests
ep:contests rdf:type owl:ObjectProperty ;
    rdfs:domain ep:TrustContest ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:contestedBy ;
    rdfs:label "contests"@en ;
    rdfs:comment "Legal contest challenges trust"@en .

###  http://example.org/trust-domain/estate-planning#modifiedByOrder
ep:modifiedByOrder rdf:type owl:ObjectProperty ;
    rdfs:domain :TrustEntity ;
    rdfs:range ep:LegalAction ;
    owl:inverseOf ep:modifies ;
    rdfs:label "modified by order"@en ;
    rdfs:comment "Trust modified by court order from legal proceeding"@en ;
    ep:glossaryTerm "Reformation, DeclaratoryJudgment" .

###  http://example.org/trust-domain/estate-planning#modifies
ep:modifies rdf:type owl:ObjectProperty ;
    rdfs:domain ep:LegalAction ;
    rdfs:range :TrustEntity ;
    owl:inverseOf ep:modifiedByOrder ;
    rdfs:label "modifies"@en ;
    rdfs:comment "Legal action modifies trust"@en .

###############################################################
###  SECTION 2: PARTICIPANT-CENTERED RELATIONSHIPS
###############################################################

###  http://example.org/trust-domain/estate-planning#owns
ep:owns rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Participant ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:ownedBy ;
    rdfs:label "owns"@en ;
    rdfs:comment "Participant owns asset"@en ;
    ep:glossaryTerm "Owner" .

###  http://example.org/trust-domain/estate-planning#ownedBy
ep:ownedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range ep:Participant ;
    owl:inverseOf ep:owns ;
    rdfs:label "owned by"@en ;
    rdfs:comment "Asset owned by participant"@en .

###  http://example.org/trust-domain/estate-planning#transfers
ep:transfers rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Participant ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:transferredBy ;
    rdfs:label "transfers"@en ;
    rdfs:comment "Participant transfers asset"@en ;
    ep:glossaryTerm "Transferor, Donor" .

###  http://example.org/trust-domain/estate-planning#transferredBy
ep:transferredBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range ep:Participant ;
    owl:inverseOf ep:transfers ;
    rdfs:label "transferred by"@en ;
    rdfs:comment "Asset transferred by participant"@en .

###  http://example.org/trust-domain/estate-planning#receives
ep:receives rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Participant ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:receivedBy ;
    rdfs:label "receives"@en ;
    rdfs:comment "Participant receives asset"@en ;
    ep:glossaryTerm "Transferee, Donee, Grantee" .

###  http://example.org/trust-domain/estate-planning#receivedBy
ep:receivedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range ep:Participant ;
    owl:inverseOf ep:receives ;
    rdfs:label "received by"@en ;
    rdfs:comment "Asset received by participant"@en .

###  http://example.org/trust-domain/estate-planning#bequeaths
ep:bequeaths rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Testator ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:bequeathedBy ;
    rdfs:label "bequeaths"@en ;
    rdfs:comment "Testator bequeaths asset via will"@en ;
    ep:glossaryTerm "Testator, Bequest" .

###  http://example.org/trust-domain/estate-planning#bequeathedBy
ep:bequeathedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range ep:Testator ;
    owl:inverseOf ep:bequeaths ;
    rdfs:label "bequeathed by"@en ;
    rdfs:comment "Asset bequeathed by testator"@en .

###  http://example.org/trust-domain/estate-planning#devises
ep:devises rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Testator ;
    rdfs:range ep:RealProperty ;
    owl:inverseOf ep:devisedBy ;
    rdfs:label "devises"@en ;
    rdfs:comment "Testator devises real property via will"@en ;
    ep:glossaryTerm "Devisor, Devise" .

###  http://example.org/trust-domain/estate-planning#devisedBy
ep:devisedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:RealProperty ;
    rdfs:range ep:Testator ;
    owl:inverseOf ep:devises ;
    rdfs:label "devised by"@en ;
    rdfs:comment "Real property devised by testator"@en .

###  http://example.org/trust-domain/estate-planning#inherits
ep:inherits rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Heir ;
    rdfs:range ep:Asset ;
    owl:inverseOf ep:inheritedBy ;
    rdfs:label "inherits"@en ;
    rdfs:comment "Heir inherits asset"@en ;
    ep:glossaryTerm "Heir, HeirAtLaw, Devisee, Legatee" .

###  http://example.org/trust-domain/estate-planning#inheritedBy
ep:inheritedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Asset ;
    rdfs:range ep:Heir ;
    owl:inverseOf ep:inherits ;
    rdfs:label "inherited by"@en ;
    rdfs:comment "Asset inherited by heir"@en .

###  Document Execution Properties

###  http://example.org/trust-domain/estate-planning#executes
ep:executes rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Participant ;
    rdfs:range ep:Document ;
    owl:inverseOf ep:executedBy ;
    rdfs:label "executes"@en ;
    rdfs:comment "Participant executes document"@en ;
    ep:glossaryTerm "Grantor, Testator, Settlor" .

###  http://example.org/trust-domain/estate-planning#executedBy
ep:executedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ep:Document ;
    rdfs:range ep:Participant ;
    owl:inverseOf ep:executes ;
    rdfs:label "executed by"@en ;
    rdfs:comment "Document executed by participant"@en .

###  http://example.org/trust-domain/estate-planning#witnesses
